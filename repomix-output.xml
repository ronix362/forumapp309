// Code Source: Gemini
import { NextResponse } from "next/server";
import { prisma } from "@/prisma/db";
import { syncMatches } from "@/utils/sync-matches";
import { Prisma } from "@/prisma/generated";
/*
As a visitor, I want to view information about upcoming and recent matches in the league.
Each match should display details such as teams, logos, date and time, venue, and scores (if completed).
As a visitor, I want to browse the different matchdays or stages of the competition.
As a visitor, I want to view match information for a specific matchday or stage of the competition.
*/

export async function GET(request: Request) {
  try {
    // 1. TIMING & SYNC LOGIC
    const syncRecord = await prisma.sportsData.findUnique({
      where: { id: 2 },
    });

    const oneHourAgo = new Date(Date.now() - 60 * 60 * 1000);

    if (!syncRecord || syncRecord.updatedAt < oneHourAgo) {
      try {
        console.log("🔄 Syncing matches with external API...");
        await syncMatches();

        await prisma.sportsData.upsert({
          where: { id: 2 },
          update: { updatedAt: new Date() },
          create: { id: 2, jsonData: { type: "match_sync_log" } },
        });
      } catch (syncError: unknown) {
        if (syncError instanceof Error) {
          console.error(
            "⚠️ Sync failed, proceeding with cached data:",
            syncError.message
          );
        } else {
          console.error("⚠️ Sync failed, proceeding with cached data");
        }
      }
    }

    // 2. SEARCH & VALIDATION LOGIC
    const { searchParams } = new URL(request.url);

    const matchday = searchParams.get("matchday");
    const status = searchParams.get("status");
    const teamId = searchParams.get("teamId");

    const errors: string[] = [];

    if (matchday) {
      const mdInt = parseInt(matchday);
      if (isNaN(mdInt) || mdInt < 1 || mdInt > 38) {
        errors.push("matchday must be 1-38");
      }
    }

    if (status && !["upcoming", "past"].includes(status)) {
      errors.push("status must be 'upcoming' or 'past'");
    }

    if (teamId && isNaN(parseInt(teamId))) {
      errors.push("teamId must be a number");
    }

    if (errors.length > 0) {
      return NextResponse.json({ errors }, { status: 400 });
    }

    const whereClause: Prisma.MatchWhereInput = {
      ...(matchday && { matchday: parseInt(matchday) }),
      ...(status === "past" && { completed: true }),
      ...(status === "upcoming" && { completed: false }),
      ...(teamId && {
        OR: [
          { homeTeamId: parseInt(teamId) },
          { awayTeamId: parseInt(teamId) },
        ],
      }),
    };

    const matches = await prisma.match.findMany({
      where: whereClause,
      include: { homeTeam: true, awayTeam: true },
      orderBy: { date: "asc" },
    });

    // 3. DYNAMIC LOCATION INJECTION
    const results = matches.map((match) => ({
      ...match,
      location: match.homeTeam?.venue || "TBD",
    }));

    return NextResponse.json(results);
  } catch (error: unknown) {
    if (error instanceof Error) {
      console.error("Critical Search Error:", error.message);
    } else {
      console.error("Critical Search Error:", error);
    }

    return NextResponse.json(
      { error: "Internal Server Error" },
      { status: 500 }
    );
  }
}
