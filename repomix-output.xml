<file path="components/Navbar.tsx">
'use client';

import { useState, useEffect, useRef } from "react";
import Link from "next/link";
import { useRouter, usePathname } from "next/navigation";
import { useTheme, AVAILABLE_AVATARS } from "@/contexts/ThemeContext";

const parseJwt = (token: string) => {
  try {
    const base64Url = token.split('.')[1];
    const base64 = base64Url.replace(/-/g, '+').replace(/_/g, '/');
    const jsonPayload = decodeURIComponent(window.atob(base64).split('').map(function(c) {
        return '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2);
    }).join(''));
    return JSON.parse(jsonPayload);
  } catch (e) {
    return null;
  }
};

export default function Navbar() {
  const { darkMode, toggleTheme } = useTheme();
  const router = useRouter();
  const pathname = usePathname(); 
  
  const [isLoggedIn, setIsLoggedIn] = useState(false);
  const [currentUserId, setCurrentUserId] = useState<number | null>(null);
  const [currentUserName, setCurrentUserName] = useState<string | null>(null);
  
  // NEW: State to store the user's avatar ID
  const [avatarId, setAvatarId] = useState<number>(0);

  const [isBanned, setIsBanned] = useState(false); 
  const [isAdmin, setIsAdmin] = useState(false);

  const [dropdownOpen, setDropdownOpen] = useState(false);
  const dropdownRef = useRef<HTMLDivElement>(null);

  useEffect(() => {
    const token = localStorage.getItem("accessToken");
    if (token) {
      const decoded = parseJwt(token);
      if (decoded && decoded.id) {
        setIsLoggedIn(true);
        setCurrentUserId(decoded.id);
        setIsAdmin(decoded.role === "ADMIN");
        const name = decoded.username || decoded.name || decoded.displayName || decoded.email?.split('@')[0];
        setCurrentUserName(name || "User");

        // Fetch user status (bans & avatar info)
        fetch(`/api/users/${decoded.id}/profile`, {
          headers: { 'Authorization': `Bearer ${token}` }
        })
        .then(res => res.json())
        .then(data => {
          if (data?.user?.banned === true) {
            setIsBanned(true);
          } else {
            setIsBanned(false);
          }

          // NEW: Grab the avatarId from the database and save it to state
          if (data?.user?.avatarId !== undefined) {
            setAvatarId(data.user.avatarId);
          }
        })
        .catch(err => console.error("Profile check failed:", err));
      }
    } else {
      setIsLoggedIn(false);
      setCurrentUserId(null);
      setCurrentUserName(null);
      setIsBanned(false);
      setAvatarId(0); // Reset avatar on logout
    }
    setDropdownOpen(false); 
  }, [pathname]);

  useEffect(() => {
    const handleClickOutside = (event: MouseEvent) => {
      if (dropdownRef.current && !dropdownRef.current.contains(event.target as Node)) {
        setDropdownOpen(false);
      }
    };
    document.addEventListener("mousedown", handleClickOutside);
    return () => document.removeEventListener("mousedown", handleClickOutside);
  }, []);

  const handleLogout = async () => {
    const refreshToken = localStorage.getItem("refreshToken");
    if (refreshToken) {
      try {
        await fetch('/api/users/logout', { 
          method: 'POST',
          headers: { 'Authorization': `Bearer ${refreshToken}` }
        });
      } catch (error) {
        console.error("Failed to server logout:", error);
      }
    }
    localStorage.removeItem("accessToken");
    localStorage.removeItem("refreshToken");
    setIsLoggedIn(false);
    setCurrentUserId(null);
    setCurrentUserName(null);
    setIsBanned(false);
    setAvatarId(0);
    router.push("/login");
  };

  return (
    <div className="sticky top-0 z-50 flex flex-col w-full shadow-sm">
      
      {/* --- BANNER FOR BANNED USERS --- */}
      {isBanned && (
        <div className="w-full bg-red-600 text-white text-sm font-bold py-2.5 px-6 flex flex-col sm:flex-row justify-center items-center gap-4 animate-in slide-in-from-top duration-300">
          <span className="flex items-center gap-2">
            ⚠️ <span>Your account is suspended. Access to posting and interacting is restricted.</span>
          </span>
          <Link 
            href="/appeal" 
            className="bg-white text-red-600 px-4 py-1 rounded-full text-xs font-black uppercase tracking-wider hover:bg-red-50 hover:scale-105 transition-all shadow-sm"
          >
            Submit Appeal
          </Link>
        </div>
      )}

      {/* --- MAIN NAVIGATION --- */}
      <nav className="flex items-center justify-between py-4 px-8 bg-white dark:bg-gray-900 border-b border-gray-200 dark:border-gray-800 transition-colors duration-200">
        
        {/* Left side: Logo & Navigation */}
        <div className="flex items-center gap-8">
          <Link href="/" className="font-bold text-xl text-blue-600 dark:text-blue-400 tracking-tighter">
            FORUM<span className="text-gray-900 dark:text-white">APP</span>
          </Link>
          <div className="hidden md:flex gap-6 text-sm font-medium text-gray-600 dark:text-gray-300">
            <Link href="/" className="hover:text-blue-600 dark:hover:text-blue-400 transition">Home</Link>
            <Link href="/dashboard" className="hover:text-blue-600 dark:hover:text-blue-400 transition">Dashboard</Link>
            <Link href="/forums" className="hover:text-blue-600 dark:hover:text-blue-400 transition">Forums</Link>
            <Link href="/teams" className="hover:text-blue-600 dark:hover:text-blue-400 transition">Teams</Link>
            <Link href="/standings" className="hover:text-blue-600 dark:hover:text-blue-400 transition">Standings</Link>
            <Link href="/matches" className="hover:text-blue-600 dark:hover:text-blue-400 transition">Matches</Link>
            <Link href="/search-users" className="hover:text-blue-600 dark:hover:text-blue-400 transition">Search Users</Link>
          </div>
        </div>

        {/* Right side: Tools & Auth */}
        <div className="flex items-center gap-4">
          <button 
            onClick={toggleTheme}
            className="p-2 rounded-full hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors"
            title="Toggle Theme"
          >
            {darkMode ? "☀️" : "🌙"}
          </button>

          {isLoggedIn ? (
            <div className="flex items-center gap-3">
              <div className="hidden sm:block text-right mr-2">
                <p className="text-xs text-gray-500 dark:text-gray-400">Welcome back,</p>
                <p className="text-sm font-bold dark:text-white">@{currentUserName}</p>
              </div>

              <div className="relative" ref={dropdownRef}>
                {/* CHANGED: Replaced the simple text circle with the avatar image logic */}
                <button 
                  onClick={() => setDropdownOpen(!dropdownOpen)}
                  className="w-10 h-10 rounded-full bg-blue-100 dark:bg-blue-900/30 flex items-center justify-center text-blue-600 dark:text-blue-400 font-bold border-2 border-transparent hover:border-blue-500 transition-all overflow-hidden"
                >
                  {AVAILABLE_AVATARS[avatarId] ? (
                    <img 
                      src={AVAILABLE_AVATARS[avatarId]} 
                      alt={currentUserName || "User"} 
                      className="w-full h-full object-cover"
                    />
                  ) : (
                    currentUserName?.charAt(0).toUpperCase()
                  )}
                </button>

                {dropdownOpen && (
                  <div className="absolute right-0 mt-3 w-56 bg-white dark:bg-gray-800 rounded-xl shadow-2xl py-2 border border-gray-100 dark:border-gray-700 overflow-hidden animate-in fade-in zoom-in duration-150">
                    <div className="px-4 py-2 border-b dark:border-gray-700 mb-1">
                      <p className="text-xs font-semibold text-gray-400 uppercase tracking-wider">Account</p>
                    </div>
                    
                    <Link href={`/profile/${currentUserId}`} className="flex items-center gap-3 px-4 py-2 text-sm text-gray-700 dark:text-gray-200 hover:bg-gray-50 dark:hover:bg-gray-700">
                      👤 My Profile
                    </Link>
                    
                    <Link href={`/profile/${currentUserId}/follow`} className="flex items-center gap-3 px-4 py-2 text-sm text-gray-700 dark:text-gray-200 hover:bg-gray-50 dark:hover:bg-gray-700">
                      👥 Network
                    </Link>

                    <Link href="/profile/edit" className="flex items-center gap-3 px-4 py-2 text-sm text-gray-700 dark:text-gray-200 hover:bg-gray-50 dark:hover:bg-gray-700">
                      ✏️ Change Profile
                    </Link>

                    {isAdmin && (
                      <Link href="/admin/appeals" className="flex items-center gap-3 px-4 py-2 text-sm font-bold text-indigo-600 dark:text-indigo-400 hover:bg-indigo-50 dark:hover:bg-indigo-900/20 border-t dark:border-gray-700 mt-1">
                        🛡️ Review Appeals
                      </Link>
                    )}

                    {isAdmin && (
                      <Link href="/admin/reports" className="flex items-center gap-3 px-4 py-2 text-sm font-bold text-indigo-600 dark:text-indigo-400 hover:bg-indigo-50 dark:hover:bg-indigo-900/20 border-t dark:border-gray-700 mt-1">
                        📝 Review Reports
                      </Link> 
                    )}

                    <button onClick={handleLogout} className="w-full text-left flex items-center gap-3 px-4 py-2 text-sm text-red-600 hover:bg-red-50 dark:hover:bg-red-900/20 mt-1 border-t dark:border-gray-700">
                      🚪 Log Out
                    </button>
                  </div>
                )}
              </div>
            </div>
          ) : (
            <div className="flex items-center gap-2">
              <Link href="/login" className="px-4 py-2 text-sm font-bold text-gray-600 dark:text-gray-300 hover:text-blue-600">
                Log In
              </Link>
              <Link href="/signup" className="px-5 py-2 bg-blue-600 text-white text-sm font-bold rounded-full hover:bg-blue-700 shadow-md">
                Sign Up
              </Link>
            </div>
          )}
        </div>
      </nav>
    </div>
  );
}
</file>

