<file path="app/profile/[id]/page.tsx">
'use client';

import { useEffect, useState } from 'react';
import { useParams, useRouter } from 'next/navigation';
import UserInfoCard from '@/components/Profile/UserInfoCard';
import FavoriteTeamCard from '@/components/Profile/FavoriteTeamCard';
import RecentThreads from '@/components/Profile/RecentThreads';
import RecentPosts from '@/components/Profile/RecentPosts';
import ActivityChart from '@/components/Profile/ActivityChart';
import { AVAILABLE_AVATARS } from '@/contexts/ThemeContext';

// Helper to decode the JWT and find out who is currently logged in
const parseJwt = (token: string) => {
  try {
    const base64Url = token.split('.')[1];
    const base64 = base64Url.replace(/-/g, '+').replace(/_/g, '/');
    const jsonPayload = decodeURIComponent(window.atob(base64).split('').map(function(c) {
        return '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2);
    }).join(''));
    return JSON.parse(jsonPayload);
  } catch (e) {
    return null;
  }
};

type Team = { id: number; name: string; };

type ActivityPoint = {
  day: string;
  count: number;
};

type ProfileData = {
  user: { 
    id: number; 
    username: string; 
    email: string; 
    role: string; // <-- Need to know the profile's role
    banned?: boolean; // <-- Need to know if they are already banned
    avatarId?: number;
    favoriteTeam: Team | null; 
  };
  stats: { followers: number; following: number; postCount: number; threadCount: number; };
  posts: any[];
  threads: any[];
  isFollowing?: boolean; 
};

export default function ViewProfilePage() {
  const params = useParams();
  const router = useRouter();
  const profileId = Number(params.id); 

  const [profileData, setProfileData] = useState<ProfileData | null>(null);
  const [error, setError] = useState('');
  const [isLoading, setIsLoading] = useState(true);
  const [activityData, setActivityData] = useState<ActivityPoint[]>([]);
  const [activityError, setActivityError] = useState('');

  // Auth & Follow states
  const [currentUserId, setCurrentUserId] = useState<number | null>(null);
  const [isAdmin, setIsAdmin] = useState(false); // Track if viewer is an admin
  
  const [isFollowing, setIsFollowing] = useState(false);
  const [isFollowLoading, setIsFollowLoading] = useState(false);

  // Ban states
  const [isBanned, setIsBanned] = useState(false);
  const [isBanLoading, setIsBanLoading] = useState(false);

  useEffect(() => {
    const token = localStorage.getItem('accessToken');
    if (token) {
      const decoded = parseJwt(token);
      if (decoded && decoded.id) {
        setCurrentUserId(decoded.id);
        setIsAdmin(decoded.role === 'ADMIN'); // Check if logged-in user is ADMIN
      }
    }

    if (!profileId) return;

    const fetchProfile = async () => {
      try {
        const headers: HeadersInit = {};
        if (token) headers['Authorization'] = `Bearer ${token}`;

        const res = await fetch(`/api/users/${profileId}/profile`, { headers });
        const data = await res.json();

        if (!res.ok) throw new Error(data.error || 'Failed to fetch profile');
        
        setProfileData(data);
        
        if (typeof data.isFollowing === 'boolean') {
          setIsFollowing(data.isFollowing);
        }
        // Set initial ban state from the backend profile data
        if (typeof data.user?.banned === 'boolean') {
          setIsBanned(data.user.banned);
        }

      } catch (err: any) {
        setError(err.message);
      }
    };

    const fetchActivityData = async () => {
      try {
        const res = await fetch(`/api/users/${profileId}/activity`);
        const data = await res.json();

        if (!res.ok) {
          throw new Error(data.error || 'Failed to fetch activity data');
        }

        setActivityData(Array.isArray(data) ? data : []);
      } catch (err: any) {
        setActivityError(err.message || 'Failed to load activity data');
      }
    };

    // Load profile and activity data in parallel. 
    const loadPageData = async () => {
      // allSettled waits for both to finish regardless of success/failure
      await Promise.allSettled([fetchProfile(), fetchActivityData()]);
      setIsLoading(false);
    };

    loadPageData();
  }, [profileId]);

  // --- FOLLOW LOGIC ---
  const handleFollowToggle = async () => {
    if (!currentUserId) {
      router.push('/login');
      return;
    }

    setIsFollowLoading(true);
    const token = localStorage.getItem('accessToken');

    try {
      if (isFollowing) {
        const res = await fetch('/api/users/following', {
          method: 'DELETE',
          headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${token}` },
          body: JSON.stringify({ followingId: profileId }) 
        });
        
        if (res.ok) {
          setIsFollowing(false);
          setProfileData(prev => prev ? { ...prev, stats: { ...prev.stats, followers: Math.max(0, prev.stats.followers - 1) } } : prev);
        } else {
          let errorMsg = "Failed to unfollow";
          try { const errData = await res.json(); errorMsg = errData.error || errorMsg; } catch (e) {}
          alert(errorMsg);
        }
      } else {
        const res = await fetch('/api/users/follow', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${token}` },
          body: JSON.stringify({ toFollowId: profileId }) 
        });

        if (res.ok) {
          setIsFollowing(true);
          setProfileData(prev => prev ? { ...prev, stats: { ...prev.stats, followers: prev.stats.followers + 1 } } : prev);
        } else {
          let errorMsg = "Failed to follow";
          try { const errData = await res.json(); errorMsg = errData.error || errorMsg; } catch (e) {}
          alert(errorMsg);
        }
      }
    } catch (err) {
      alert("Network error: Could not connect to the server.");
    } finally {
      setIsFollowLoading(false);
    }
  };

  // --- BAN LOGIC ---
  const handleBanToggle = async () => {
    if (!isAdmin) return;
    
    // Confirm before taking severe actions
    const actionText = isBanned ? "unban" : "ban";
    if (!confirm(`Are you sure you want to ${actionText} @${profileData?.user.username}?`)) {
      return;
    }

    setIsBanLoading(true);
    const token = localStorage.getItem('accessToken');
    
    // Dynamically choose endpoint based on current state
    const endpoint = isBanned ? '/api/users/unban' : '/api/users/ban';

    try {
      const res = await fetch(endpoint, {
        method: 'PATCH',
        headers: { 
          'Content-Type': 'application/json', 
          'Authorization': `Bearer ${token}` 
        },
        // Both your ban and unban scripts expect `userId` in the body
        body: JSON.stringify({ userId: profileId }) 
      });

      if (res.ok) {
        setIsBanned(!isBanned);
      } else {
        let errorMsg = `Failed to ${actionText} user`;
        try { const errData = await res.json(); errorMsg = errData.error || errorMsg; } catch (e) {}
        alert(errorMsg);
      }
    } catch (err) {
      console.error("Ban toggle error:", err);
      alert("Network error: Could not connect to the server.");
    } finally {
      setIsBanLoading(false);
    }
  };

  if (isLoading) {
    return (
      <div className="min-h-screen flex items-center justify-center bg-gray-50 dark:bg-gray-900 transition-colors">
        <p className="text-gray-500 dark:text-gray-400 font-medium animate-pulse">Loading profile...</p>
      </div>
    );
  }

  if (error || !profileData) {
    return (
      <div className="min-h-screen flex items-center justify-center bg-gray-50 dark:bg-gray-900 transition-colors">
        <div className="p-4 bg-red-100 dark:bg-red-900/30 text-red-700 dark:text-red-400 rounded-md border-l-4 border-red-500 shadow-sm">
          {error || 'User not found.'}
        </div>
      </div>
    );
  }

  const isOwnProfile = currentUserId === profileData.user.id;
  
  // Show Ban button ONLY if the logged-in user is an Admin, it's NOT their own profile, 
  // and they aren't trying to ban another Admin (since your backend prevents that anyway).
  const showAdminControls = isAdmin && !isOwnProfile && profileData.user.role !== 'ADMIN';

  return (
    <div className="min-h-screen bg-gray-50 dark:bg-gray-900 py-10 px-4 sm:px-6 lg:px-8 transition-colors duration-200">
      
      {/* Visual Banned Indicator */}
      {isBanned && (
        <div className="max-w-6xl mx-auto mb-6 bg-red-600 text-white p-4 rounded-xl text-center font-bold shadow-md">
          ⚠️ This account is currently suspended.
        </div>
      )}

      <div className="max-w-6xl mx-auto flex flex-col md:flex-row gap-8">
        
        {/* ================= LEFT SIDEBAR ================= */}
        <div className="w-full md:w-1/3 space-y-6">
          
          {/* MODIFIED: We pass the avatarUrl directly into the UserInfoCard props.
              It uses the avatarId from our profileData to pick the right image 
              from the AVAILABLE_AVATARS array.
          */}
          <UserInfoCard 
            user={{
              ...profileData.user,
              avatarUrl: AVAILABLE_AVATARS[profileData.user.avatarId || 0]
            }} 
            stats={profileData.stats} 
          />
          
          <div className="space-y-3">
            {/* Conditional Follow/Unfollow Button */}
            {!isOwnProfile && currentUserId !== null && (
              <button 
                onClick={handleFollowToggle}
                disabled={isFollowLoading}
                className={`w-full py-3 px-4 font-bold rounded-xl transition-all shadow-sm ${
                  isFollowing 
                    ? 'bg-gray-200 text-gray-800 hover:bg-red-100 hover:text-red-600 dark:bg-gray-800 dark:text-gray-200 dark:hover:bg-red-900/40 dark:hover:text-red-400 border border-transparent hover:border-red-200 dark:hover:border-red-800' 
                    : 'bg-blue-600 text-white hover:bg-blue-700 hover:scale-[1.02]'
                } disabled:opacity-50 disabled:hover:scale-100`}
              >
                {isFollowLoading ? 'Updating...' : isFollowing ? 'Unfollow' : 'Follow'}
              </button>
            )}

            {/* Conditional Admin Controls (Ban/Unban) */}
            {showAdminControls && (
              <button 
                onClick={handleBanToggle}
                disabled={isBanLoading}
                className={`w-full py-3 px-4 font-bold rounded-xl border-2 transition-all shadow-sm ${
                  isBanned 
                    ? 'border-green-600 text-green-600 hover:bg-green-50 dark:border-green-500 dark:text-green-500 dark:hover:bg-green-900/20' 
                    : 'border-red-600 text-red-600 hover:bg-red-50 dark:border-red-500 dark:text-red-500 dark:hover:bg-red-900/20'
                } disabled:opacity-50`}
              >
                {isBanLoading ? 'Processing...' : isBanned ? '🛡️ Unban User' : '🛑 Ban User'}
              </button>
            )}
          </div>

          <FavoriteTeamCard team={profileData.user.favoriteTeam} />
        </div>

        {/* ================= RIGHT MAIN CONTENT ================= */}
        <div className="w-full md:w-2/3 space-y-6">
          
          <RecentThreads threads={profileData.threads} />
          <RecentPosts posts={profileData.posts} />
          {activityError ? (
            <div className="p-4 bg-red-100 dark:bg-red-900/30 text-red-700 dark:text-red-400 rounded-md border-l-4 border-red-500 shadow-sm">
              {activityError}
            </div>
          ) : (
            <ActivityChart data={activityData} />
          )}
        </div>

      </div>
    </div>
  );
}
</file>

<file path="prisma/schema.prisma">
// This is your Prisma schema file,

generator client {
  provider = "prisma-client-js"
  output   = "./generated"
}

// dev.db: It is a SQLite database file
// It stores: All your tables / All your rows (data) / All schema changes from migrations//
//datasource db {
//  provider = "sqlite"
//  url = "file:./dev.db"
//}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --------------------------------------
// ENUMS
// --------------------------------------

enum Role {
  ADMIN
  USER
  VISITOR
}

enum AppealStatus {
  APPROVED
  IN_PROGRESS
  DENIED
}

enum FollowActionType {
  FOLLOW
  REMOVE_FOLLOW
}

enum ForumType {
  GENERAL
  MATCH
  TEAM
}

enum ReportStatus {
  PENDING
  DISMISSED
  APPROVED
  HIDDEN
}

// --------------------------------------
// USER & AUTH
// --------------------------------------

model User {
  id          	Int      	@id @default(autoincrement())
  email       	String   @unique @default("")
  password    String?   	@default("")
  username    String   @unique @default("")
  avatarId       Int       @default(0)
  role        	Role     @default(USER)
  banned      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Profile Relations
  favoriteTeamId Int?
  favoriteTeam   Team? @relation("UserFavoriteTeam", fields: [favoriteTeamId], references: [id])

  // Social Relations (Followers/Following)
  followers  Follow[]  @relation("UserFollowers")
  following  Follow[]  @relation("UserFollowing")

  // Activity Relations
  appeals       	Appeal[]
  posts         	Post[]
  threads       	Thread[]
  polls         	Poll[]
  pollVotes     	PollVote[]
  reports       	Report[]
  refreshTokens RefreshToken[]
}

// Keep track of the status of the RefreshToken in DB, if a RefreshToken
// is logged out, it will be removed from the DB.
model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Appeal {
  id      Int          @id @default(autoincrement())
  status  AppealStatus @default(IN_PROGRESS)
  content String
  userId  Int
  user    User         @relation(fields: [userId], references: [id])
}

model Follow {
  date       DateTime         @default(now())

  followerId Int
  follower    User @relation("UserFollowing", fields: [followerId], references: [id])

  followingId Int
  following   User @relation("UserFollowers", fields: [followingId], references: [id])
  @@id([followerId, followingId]) // Prevents duplicate follows
}

// --------------------------------------
// SPORTS DATA
// --------------------------------------

model Team {
  id      Int    @id @default(autoincrement())
  name    String
  logoUrl String
  venue      String?
  
  // Relations
  fans        User[]  @relation("UserFavoriteTeam")
  seasonYear  Int      @default(2025) // Keep the current season only.
  homeMatches Match[] @relation("HomeTeam")
  awayMatches Match[] @relation("AwayTeam")
  
  // A team can optionally have a specific Forum
  forum       Forum?
}

model Match {
  id         Int      @id @default(autoincrement())
  date       DateTime
  homeScore Int?     // Nullable if match hasn't started
  awayScore Int?
  matchday   Int
  stage      String
  completed  Boolean  @default(false)
  winnerName String?

  // Teams
  homeTeamId Int
  homeTeam   Team @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeamId Int
  awayTeam   Team @relation("AwayTeam", fields: [awayTeamId], references: [id])

  // Forum Integration
  // "DiscussionThread" - 1 per match standard thread
  discussionThread   Thread? @relation("MatchDiscussionThread", fields: [discussionThreadId], references: [id])
  discussionThreadId Int?    @unique
}

// --------------------------------------
// FORUM & SOCIAL
// --------------------------------------

model Forum {
  id       Int       @id @default(autoincrement())
  type     ForumType // GENERAL, MATCH, TEAM
  teamName String?   // Optional: if it is a specific team forum

  // Relations to connect Forum to specific entities
  teamId   Int?  @unique
  team     Team? @relation(fields: [teamId], references: [id])

  threads Thread[]

  @@unique([type, teamName])
}

model Thread {
  id                Int      @id @default(autoincrement())
  title             String
  tags       ThreadTag[]
  visibility        Boolean  @default(true)
  createdAt         DateTime @default(now())
  homeTeamSentiment String?
  awayTeamSentiment String?

  // Relations
  authorId Int
  author   User @relation(fields: [authorId], references: [id])

  forumId Int
  forum   Forum @relation(fields: [forumId], references: [id])

  // Posts
  posts Post[] @relation("ThreadPosts")

  // Pointer to the "Main Post" (The OP)
  mainPost   Post? @relation("ThreadMainPost", fields: [mainPostId], references: [id])
  mainPostId Int?  @unique

  // If this thread is the specific discussion thread for a match
  matchDiscussionFor Match? @relation("MatchDiscussionThread")
  matchId    Int? @unique

  polls   Poll[]
  reports Report[]
  reportCount       Int   @default(0)

  // Ai Moderation
  aiAvgScore  Int? 
}

model ThreadTag {
  id       Int    @id @default(autoincrement())
  name     String
  thread   Thread @relation(fields: [threadId], references: [id])
  threadId Int
}

model Post {
  id         Int      @id @default(autoincrement())
  content    String
  visibility Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  authorId Int
  author   User @relation(fields: [authorId], references: [id])

  threadId Int
  thread   Thread @relation("ThreadPosts", fields: [threadId], references: [id])

  // If this post is the Main Post of the thread
  mainPostFor Thread? @relation("ThreadMainPost")

  // Reply Logic (Tree structure)
  replyingToId Int?
  replyingTo   Post?  @relation("PostReplies", fields: [replyingToId], references: [id])
  replies      Post[] @relation("PostReplies")

  // Edit History (Linked List)
  // oldPost points to the previous version
  previousVersionId Int?  @unique
  previousVersion   Post? @relation("PostHistory", fields: [previousVersionId], references: [id])
  
  // editedPost points to the next version
  nextVersionId Int?  @unique
  nextVersion       Post? @relation("PostHistory")

  reports Report[]
  reportCount       Int   @default(0)

  // AI moderation
  aiFlagged         Boolean?
  aiMaxScore        Int?
  aiScores          Json?
  }

model Report {
  id                 Int          @id @default(autoincrement())
  reason             String
  status             ReportStatus @default(PENDING)
  createdAt          DateTime     @default(now())

  userId Int
  user   User @relation(fields: [userId], references: [id])

  // Targets (Optional, report can be on Post or Thread)
  postId   Int?
  post     Post?   @relation(fields: [postId], references: [id])
  threadId Int?
  thread   Thread? @relation(fields: [threadId], references: [id])

  pollId Int?
  poll   Poll? @relation(fields: [pollId], references: [id])
}

// --------------------------------------
// POLLS
// --------------------------------------

model Poll {
  id              Int      @id @default(autoincrement())
  pollDescription String   @map("poll_description")
  options         PollOption[]
  deadline        DateTime
  visibility      Boolean  @default(true)
  createdAt       DateTime @default(now())

  authorId Int
  author   User @relation(fields: [authorId], references: [id])

  threadId Int
  thread   Thread @relation(fields: [threadId], references: [id])

  pollVotes PollVote[]
  reports   Report[]
  reportCount       Int   @default(0)
  
  // AI moderation
  aiFlagged         Boolean?
  aiMaxScore        Int?
  aiScores          Json?
}

model PollOption {
  id     Int    @id @default(autoincrement())
  text   String
  poll   Poll   @relation(fields: [pollId], references: [id])
  pollId Int
}

model PollVote {
  id          Int      @id @default(autoincrement())
  optionIndex Int
  createdAt   DateTime @default(now())

  pollId Int
  poll   Poll @relation(fields: [pollId], references: [id])

  userId Int
  user   User @relation(fields: [userId], references: [id])

  // Ensure a user cannot vote twice in the same poll
  @@unique([pollId, userId])
}

// --------------------------------------
// EXTERNAL DATA PLACEHOLDER
// --------------------------------------

model SportsData {
  id        Int      @id @default(autoincrement())
  jsonData  Json?
  updatedAt DateTime @updatedAt
}

model AiDigest {
  id        Int      @id @default(autoincrement())
  digest    String
  createdAt DateTime  @default(now())
}
</file>

