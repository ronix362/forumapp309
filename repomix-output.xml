import { NextResponse, NextRequest } from "next/server";
import { prisma } from "@/prisma/db"; // Adjust this path if you moved it to @/utils/prisma
import { verifyAccessToken } from "@/utils/auth"; // Adjust this path if you moved it to @/lib/auth

export async function GET(req: NextRequest, { params }: { params: Promise<{ user: string }> }) {
  try {
    const { user: userParam } = await params;
    const userId = parseInt(userParam);

    // 1. Check if the viewer is logged in to determine 'isFollowing'
    const authHeader = req.headers.get("authorization");
    let viewerId: number | null = null;
    try {
      if (authHeader) {
        const decoded = verifyAccessToken(authHeader);
        viewerId = decoded.userId;
      }
    } catch (e) {
      // Viewer is guest, that's fine
    }

    const profile = await prisma.user.findUnique({
      where: { id: userId },
      include: {
        favoriteTeam: true,
        _count: {
          select: {
            followers: true,
            following: true,
            posts: true,
            threads: true,
          },
        },
        posts: { orderBy: { createdAt: 'desc' }, take: 10 },
        threads: { orderBy: { createdAt: 'desc' }, take: 10 },
      },
    });

    if (!profile) {
      return NextResponse.json({ error: "User not found" }, { status: 404 });
    }

    // 2. Check if the viewer follows this profile
    let isFollowing = false;
    if (viewerId && viewerId !== userId) {
      const followDoc = await prisma.follow.findUnique({
        where: {
          followerId_followingId: {
            followerId: viewerId,
            followingId: userId,
          },
        },
      });
      isFollowing = !!followDoc;
    }

    // 3. Flatten response
    return NextResponse.json({
      user: {
        id: profile.id,
        username: profile.username,
        email: profile.email,
        role: profile.role,     
        banned: profile.banned, 
        avatarId: profile.avatarId, // <--- CHANGED: Added avatarId here so the Navbar can read it!
        favoriteTeam: profile.favoriteTeam,
      },
      stats: {
        followers: profile._count.followers,
        following: profile._count.following,
        postCount: profile._count.posts,
        threadCount: profile._count.threads,
      },
      isFollowing, 
      posts: profile.posts,
      threads: profile.threads,
    });

  } catch (error) {
    console.error("Error fetching profile:", error);
    return NextResponse.json({ error: "Internal Server Error" }, { status: 500 });
  }
}
