import { NextResponse } from "next/server";
import { prisma } from "@/prisma/db";
import { verifyAccessToken } from "@/utils/auth";

export async function GET(request: Request) {
  try {
    const token = request.headers.get("authorization");

    const { searchParams } = new URL(request.url);
    const page = Number(searchParams.get("page"));
    const section = searchParams.get("section") || "recent";

    if (!page || isNaN(page) || page <= 0) {
      return NextResponse.json(
        { error: "page must be a positive number" },
        { status: 400 },
      );
    }

    // For visitors, just return recent posts.
    if (!token) {
      const recentPosts = await prisma.post.findMany({
        take: 10,
        skip: (page - 1) * 10,
        orderBy: { createdAt: "desc" },
        include: { author: { select: { username: true } } },
      });
      return NextResponse.json({ recentPosts });
    }

    const { userId } = verifyAccessToken(token);

    const user = await prisma.user.findUnique({ where: { id: userId } });
    const favTeamId = user?.favoriteTeamId;

    // Only run the query for the requested section
    switch (section) {
      case "matches": {
        const [favTeamUpcomingMatches, favTeamRecentResults] = await Promise.all([
          favTeamId ? prisma.match.findMany({
            take: 5,
            skip: (page - 1) * 5,
            where: {
              AND: [
                { OR: [{ homeTeamId: favTeamId }, { awayTeamId: favTeamId }] },
                { date: { gte: new Date() } },
              ],
            },
            include: { homeTeam: true, awayTeam: true },
            orderBy: { date: "asc" },
          }) : Promise.resolve([]),

          favTeamId ? prisma.match.findMany({
            take: 5,
            skip: (page - 1) * 5,
            where: {
              AND: [
                { OR: [{ homeTeamId: favTeamId }, { awayTeamId: favTeamId }] },
                { date: { lt: new Date() } },
                { homeScore: { not: null } },
                { awayScore: { not: null } },
              ],
            },
            include: { homeTeam: true, awayTeam: true },
            orderBy: { date: "desc" },
          }) : Promise.resolve([]),
        ]);
        return NextResponse.json({ favTeamUpcomingMatches, favTeamRecentResults });
      }

      case "threads": {
        const favTeamThreads = favTeamId ? await prisma.forum.findUnique({
          where: { teamId: favTeamId },
          include: {
            threads: {
              orderBy: { createdAt: "desc" },
              take: 10,
              skip: (page - 1) * 10,
              include: { _count: { select: { posts: true, polls: true } } },
            },
          },
        }) : [];
        return NextResponse.json({ favTeamThreads });
      }

      case "following": {
        const followedPosts = await prisma.post.findMany({
          take: 10,
          skip: (page - 1) * 10,
          where: {
            author: {
              followers: { some: { followerId: userId } },
            },
          },
          orderBy: { createdAt: "desc" },
          include: { author: { select: { username: true } } },
        });
        return NextResponse.json({ followedPosts });
      }

      case "replies": {
        const replyingPosts = await prisma.post.findMany({
          take: 10,
          skip: (page - 1) * 10,
          where: { replyingToId: userId },
          orderBy: { createdAt: "desc" },
          include: { author: { select: { username: true } } },
        });
        return NextResponse.json({ replyingPosts });
      }

      case "recent":
      default: {
        const recentPosts = await prisma.post.findMany({
          take: 10,
          skip: (page - 1) * 10,
          orderBy: { createdAt: "desc" },
          include: { author: { select: { username: true } } },
        });
        return NextResponse.json({ recentPosts });
      }
    }
  } catch (error) {
    if (error instanceof Error) {
      if (error.message.startsWith("Unauthorized")) {
        return NextResponse.json({ error: error.message }, { status: 401 });
      }
      console.error("Error fetching feed:", error.message);
    }
    return NextResponse.json({ error: "Internal server error." }, { status: 500 });
  }
}
</file>

